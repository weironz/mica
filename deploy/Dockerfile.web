# Self-contained web image: nginx + the prebuilt Flutter bundle + routing.
# Build context is the repo root AFTER `just web-build` staged the bundle:
#   docker build -f deploy/Dockerfile.web -t willdockerhub/mica-web:vX.Y .
FROM nginx:alpine
# Modes set HERE, not inherited from whatever machine staged the bundle. COPY
# keeps the build context's modes, and nginx's workers read as the `nginx` user:
# v0.13.60 was the first image built on a self-hosted runner whose umask made
# the bundle 0600/0700, and production answered every page with 403. 0755 on the
# bundle because one --chmod covers files and directories alike — directories
# need the x bit, and an x bit on a static file is inert.
COPY --chmod=0644 deploy/nginx.conf /etc/nginx/nginx.conf
COPY --chmod=0755 deploy/web /usr/share/nginx/html
# Fail the BUILD, not the deploy, if the worker user still cannot read the page.
RUN su -s /bin/sh nginx -c 'test -r /usr/share/nginx/html/index.html && test -x /usr/share/nginx/html/assets' \
  || { echo "nginx cannot read the web bundle — check the modes above" >&2; exit 1; }
EXPOSE 80
