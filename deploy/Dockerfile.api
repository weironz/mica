# Multi-stage build for the Mica API server.
# Build: docker compose -f docker-compose.prod.yml build api

# Pin the builder to bookworm (glibc 2.36) to match the debian:bookworm-slim
# runtime — a bare `rust:<ver>-slim` tag now tracks trixie (glibc 2.40), which
# would let the binary pick up GLIBC_2.38+ symbols the runtime lacks. See
# Dockerfile.cli.
#
# The VERSION half comes from rust-toolchain.toml — this image, that file and
# docker-compose.yml are deliberately one number, and release-check refuses when
# they drift. (Floor for the `render` export deps: merman needs Rust ≥1.95.)
FROM rust:1.100-slim-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY migrations ./migrations
COPY scripts/check-migration-bytes.sh ./scripts/check-migration-bytes.sh
RUN sh scripts/check-migration-bytes.sh
# CI keeps the Mica builder's state across jobs; cache mounts are not exported
# by cache-to=gha. Copy the binary out before the target mount is detached.
RUN --mount=type=cache,id=mica-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=mica-cargo-target-1.100,target=/src/target,sharing=locked \
    cargo build --locked --release -p mica-api-server \
 && cp target/release/mica-api-server /usr/local/bin/mica-api-server-staged

FROM debian:bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*
COPY --from=build /usr/local/bin/mica-api-server-staged /usr/local/bin/mica-api-server
ENV RUST_LOG=info
EXPOSE 8080
# /api/ready (not /api/health): it pings the Postgres pool, so an api that is
# up but cannot reach the DB reports unhealthy instead of masking the outage.
#
# Exec form, never `CMD curl ... || exit 1` (gh#168): the shell form runs the
# probe under `sh -c`, and when a slow check hits --timeout Docker kills only
# the shell. The orphaned curl is re-parented to PID 1 — this server, which
# does not reap children — and stays a zombie (469 seen on the prod node).
# In exec form curl is the process Docker kills, and --max-time ends it before
# the timeout anyway. Compose also runs an init (`init: true`) as PID 1.
HEALTHCHECK --interval=10s --timeout=3s --retries=10 \
  CMD ["curl", "-fsS", "--max-time", "2", "-o", "/dev/null", "http://127.0.0.1:8080/api/ready"]
CMD ["mica-api-server"]
