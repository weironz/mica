# Traefik stack config — copy to `.env` NEXT TO the compose file on the node
# (production keeps it at /data/traefik/.env) and fill in.
#
# Separate from the Mica stack's .env (deploy/.env.prod.example) on purpose:
# different lifecycle, different stakes. Everything here can be regenerated from
# scratch on a new machine without losing data, which is emphatically NOT true
# of the Mica one — see its RUSTIC_PASSWORD warning.

# ── Image ────────────────────────────────────────────────────────────────────
# The WHOLE reference, not just the tag, despite the variable's name.
TRAEFIK_IMAGE_TAG=traefik:v3.6.10

# ── Logging ──────────────────────────────────────────────────────────────────
# DEBUG / INFO / WARN / ERROR. Production runs WARN: access logging is enabled
# separately, and INFO on a public proxy is mostly certificate housekeeping.
TRAEFIK_LOG_LEVEL=WARN

# ── ACME / Let's Encrypt ─────────────────────────────────────────────────────
# Where expiry warnings go. Use a real address — it is the only channel that
# will tell you a renewal has been failing.
#
# Issuance uses the TLS-ALPN-01 challenge on :443, so the DNS A records must
# ALREADY resolve to this machine before first start. Certificates live in the
# `traefik-certificates` volume; re-issuing after losing it counts against
# Let's Encrypt rate limits, so the volume is not disposable.
TRAEFIK_ACME_EMAIL=you@example.com

# ── Dashboard ────────────────────────────────────────────────────────────────
# Hostname the dashboard answers on — needs its own DNS A record. Served over
# HTTPS behind the basic auth below.
TRAEFIK_HOSTNAME=traefik.example.com

# htpasswd-style `user:hash` (MD5, SHA1, or bcrypt). Generate with:
#   htpasswd -nbB traefikadmin '<password>'
#
# In a .env read by compose, every `$` must be doubled to `$$`. Miss that and
# interpolation eats parts of a bcrypt hash, leaving a login that fails exactly
# as if the password were wrong.
TRAEFIK_BASIC_AUTH=traefikadmin:$$2y$$05$$replace.this.with.a.real.bcrypt.hash
