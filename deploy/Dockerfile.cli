# The Mica backup container: the mica-cli thin API client + the external `rustic`
# CLI, packaged as a small always-on service that exports every workspace and
# snapshots it into one rustic repo daily. mica-cli itself has NO backup engine
# (that was retired — see docs/backup.md); rustic owns encryption/dedup/retention.
#   docker build -f deploy/Dockerfile.cli -t willdockerhub/mica-cli:vX.Y .

# ── mica-cli (thin API client) ───────────────────────────────────────────────
# bookworm builder to match the bookworm-slim runtime's glibc; mica-cli is pure
# Rust + rustls (no OpenSSL), so this is only about a consistent libc floor.
FROM rust:1.97-slim-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN cargo build --release -p mica-cli

# ── rustic CLI (external backup engine), checksum-pinned ──────────────────────
# The musl build is fully static → runs on the bookworm-slim runtime with no
# glibc dependency (sidesteps the GLIBC_2.38 gotcha entirely).
FROM debian:bookworm-slim AS rustic
ARG RUSTIC_VERSION=v0.11.3
ARG RUSTIC_SHA256=3298555dc3da30d1cdf6775783e7c777ac4d148708721b3aecbe630ac827b3a9
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && curl -fsSL -o /tmp/rustic.tar.gz \
      "https://github.com/rustic-rs/rustic/releases/download/${RUSTIC_VERSION}/rustic-${RUSTIC_VERSION}-x86_64-unknown-linux-musl.tar.gz" \
 && echo "${RUSTIC_SHA256}  /tmp/rustic.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/rustic.tar.gz -C /tmp \
 && install -m755 "$(find /tmp -maxdepth 2 -type f -name rustic | head -1)" /usr/local/bin/rustic \
 && /usr/local/bin/rustic --version

# ── rclone CLI (object-store mirror), checksum-pinned ────────────────────────
# Used ONLY for the blob leg: RustFS S3 → OSS, S3 to S3, never through rustic
# (mica-backup.sh 4c explains why immutable content-addressed blobs want a
# mirror, not snapshots). Same shape as the rustic stage above: static build,
# pinned version + sha256, `--version` as a smoke test so a bad download fails
# the image build instead of the 3am backup.
# NOTE — weaker than the rustic pin above, on purpose and temporarily: this
# verifies the zip against the release's own published SHA256SUMS instead of a
# hash pinned here. That catches a corrupted or truncated download but NOT a
# compromised release (an attacker who can rewrite the asset can rewrite the
# sums file next to it). TO HARDEN: run the build once, copy the printed digest
# into RCLONE_SHA256, and switch the check back to the `echo … | sha256sum -c -`
# form the rustic stage uses. Left unpinned rather than pinned to a hash nobody
# verified — a wrong-but-official-looking constant is worse than an honest gap.
FROM debian:bookworm-slim AS rclone
ARG RCLONE_VERSION=v1.68.2
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates unzip \
 && base="https://github.com/rclone/rclone/releases/download/${RCLONE_VERSION}" \
 && curl -fsSL -o /tmp/rclone.zip "${base}/rclone-${RCLONE_VERSION}-linux-amd64.zip" \
 && curl -fsSL -o /tmp/SHA256SUMS "${base}/SHA256SUMS" \
 && ( cd /tmp && grep "rclone-${RCLONE_VERSION}-linux-amd64.zip$" SHA256SUMS | sha256sum -c - ) \
 && echo "rclone zip digest: $(sha256sum /tmp/rclone.zip | cut -d' ' -f1)  ← pin this into RCLONE_SHA256" \
 && unzip -q /tmp/rclone.zip -d /tmp \
 && install -m755 "$(find /tmp -maxdepth 2 -type f -name rclone | head -1)" /usr/local/bin/rclone \
 && /usr/local/bin/rclone --version

# ── runtime ──────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim
# ca-certificates: TLS to the API + OSS. curl: needed right below to fetch the
# PGDG signing key at build time. (jq is gone — the export manifest is parsed by
# serde_json now, and the dead man's switch pings through reqwest; both moved
# into mica-cli when the backup scripts did.)
# postgresql-client-16: pg_dump for the off-site DB snapshot (mica-backup.sh).
# It must be v16+ to dump the prod postgres:16 server — a pg_dump older than the
# server aborts on a version mismatch — so pull it from PGDG rather than
# bookworm's stock 15.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && curl -fsSL -o /usr/share/keyrings/pgdg.asc https://www.postgresql.org/media/keys/ACCC4CF8.asc \
 && echo "deb [signed-by=/usr/share/keyrings/pgdg.asc] http://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends postgresql-client-16 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/mica-cli /usr/local/bin/mica-cli
COPY --from=rustic /usr/local/bin/rustic /usr/local/bin/rustic
COPY --from=rclone /usr/local/bin/rclone /usr/local/bin/rclone
ENV RUST_LOG=info MICA_EXPORT_DIR=/var/lib/mica/export
# The backup orchestration used to be two shell scripts copied in here. It is
# now `mica-cli backup` — the same external tools (rustic / rclone / pg_dump),
# but the run reports which legs actually ran and refuses to exit 0 having
# quietly covered less than a full instance. See crates/cli/src/backup.rs.
ENTRYPOINT ["/usr/local/bin/mica-cli", "backup", "daemon"]
