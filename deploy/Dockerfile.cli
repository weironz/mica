# The slim Mica backup container: pure `mica-cli` packaged as a small always-on
# service that incrementally mirrors every workspace (Markdown + images) into
# `/var/lib/mica/export` on schedule. Off-site encryption, dedup, retention and
# upload to Aliyun OSS (`mica-backup/mica-md`) are owned by Zerobyte; PostgreSQL
# and RustFS backups are owned by Databasus and Zerobyte respectively.
#   docker build -f deploy/Dockerfile.cli -t willdockerhub/mica-cli:vX.Y .

# ── mica-cli (thin API client) ───────────────────────────────────────────────
# bookworm builder to match the bookworm-slim runtime's glibc; mica-cli is pure
# Rust + rustls (no OpenSSL), so this is only about a consistent libc floor.
FROM rust:1.100-slim-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY benchmarks ./benchmarks
COPY crates ./crates
# Keep the same mount keys as Dockerfile.api for persistent Mica builders.
RUN --mount=type=cache,id=mica-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=mica-cargo-target-1.100,target=/src/target,sharing=locked \
    cargo build --locked --release -p mica-cli \
 && cp target/release/mica-cli /usr/local/bin/mica-cli-staged

# ── runtime ──────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS runtime-base
# ca-certificates: TLS for HTTPS API endpoints and optional HEALTHCHECK_URL.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
ENV RUST_LOG=info MICA_EXPORT_DIR=/var/lib/mica/export
# ENTRYPOINT is the binary; CMD provides the default daemon schedule so ad-hoc
# invocations (`docker exec mica-backup-1 mica-cli backup run` or `export ...`)
# work directly without `--entrypoint`.
ENTRYPOINT ["/usr/local/bin/mica-cli"]
CMD ["backup", "daemon"]

# Fast packaging target for CI/Ship runs that already compiled the glibc-2.36
# binary inside `rust:1.100-slim-bookworm` with Actions cache.
FROM runtime-base AS runtime-prebuilt
ARG PREBUILT_BIN=deploy/prebuilt/mica-cli
COPY --chmod=0755 ${PREBUILT_BIN} /usr/local/bin/mica-cli

# Default standalone target: compiles from source inside `build` above.
FROM runtime-base AS runtime
COPY --from=build /usr/local/bin/mica-cli-staged /usr/local/bin/mica-cli
