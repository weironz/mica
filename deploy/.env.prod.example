# Production environment — copy to the repo root as `.env.prod` and edit.
# NEVER commit the real file (gitignored).
#
# Serves BOTH stacks. Fill in the block that matches the one you run:
#   deploy/docker-compose.single.yml   quickstart, reached by IP  → SERVER_IP
#   deploy/docker-compose.yml          behind an existing Traefik → DOMAIN + S3_DOMAIN

# ── Image tag (api + web + backup all move together) ─────────────────────────
# Pick a real release: https://github.com/weironz/mica/releases
# The quickstart stack REFUSES to start without this rather than defaulting to
# whichever tag happened to be current when this file was written.
MICA_VERSION=v0.13.6
# Where to pull from. Defaults to Docker Hub; the maintainer's own server
# overrides it to Aliyun ACR because it runs in CN, where Hub is not dependable.
# MICA_REGISTRY=willdockerhub

# ── QUICKSTART STACK — the address browsers will use ─────────────────────────
# Presigned S3 URLs embed it, so it has to be reachable FROM THE BROWSER: a
# public IP or a hostname. Not `localhost`, not a docker-internal name.
# SERVER_IP=203.0.113.10

# ── TRAEFIK STACK — public hostnames; both need DNS A records ────────────────
# Ignore these two if you are running the quickstart.
DOMAIN=mica.example.com
S3_DOMAIN=s3.mica.example.com          # presigned S3 URLs embed this; own record

# ── App CORS (browser cross-origin reads) ────────────────────────────────────
# Empty/unset = deny all cross-origin (the web app is served same-origin with
# /api, so it needs no grant). Set ONLY if a separate origin must call the API.
# CORS_ALLOWED_ORIGINS=https://other.example.com,https://app2.example.com

# ── Accounts: public self-registration ───────────────────────────────────────
# CLOSED unless you open it here: only an explicit true/1/yes/on opens
# POST /auth/register, and anything else — unset, empty, or a typo — keeps it
# 403ing. Login/refresh for existing accounts are unaffected, and a brand-new
# instance can still create its very FIRST account, so a fresh self-hosted
# install is usable without ever touching this line. Opening it on a public
# node lets strangers mint accounts; they must verify their email to log in.
# MICA_REGISTRATION_ENABLED=true

# ── Password-reset email (see docs/password-reset.md) ────────────────────────
# Default backend "log" writes the reset link to the SERVER LOG and sends nothing
# — the flow still works (read the link from the logs), so leaving this unset is
# a valid "no email yet" state. Set "directmail" + the vars below to send via
# Aliyun DirectMail (邮件推送); missing required vars fall back to "log" with a
# warning, never a crash. MICA_MAIL_FROM must match the verified DirectMail
# sender address exactly. The sender domain is DNS-only (TXT/DKIM) — it needs no
# A record and no Traefik rule; only the reset-LINK domain (below) is inbound.
# MICA_APP_BASE_URL=https://mica.example.com     # origin the emailed link points at; default https://<DOMAIN>
# MICA_MAIL_BACKEND=directmail
# MICA_MAIL_FROM=noreply@mail.example.com        # verified DirectMail sender address (AccountName)
# MICA_MAIL_FROM_NAME=Mica                       # optional display name recipients see
# MICA_MAIL_ACCESS_KEY_ID=
# MICA_MAIL_ACCESS_KEY_SECRET=
# MICA_MAIL_REGION=cn-hangzhou                   # default; rarely changed
# MICA_MAIL_ENDPOINT=https://dm.aliyuncs.com/    # default; only for a regional endpoint

# ── Secrets — generate strong values:  openssl rand -hex 32 ──────────────────
JWT_SECRET=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_USER=mica
POSTGRES_DB=mica

# ── RustFS (S3-compatible store for image bytes) ─────────────────────────────
S3_BUCKET=mica
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_REGION=us-east-1

# ── Backup (opt-in: `docker compose --profile backup up -d`; see docs/backup.md)
# A read-scoped Mica PAT + a rustic repo password + a LEAST-PRIVILEGE Aliyun OSS
# RAM AccessKey scoped to one bucket. Leave blank to run without backups.
MICA_BACKUP_TOKEN=
MICA_BACKUP_PASSWORD=                   # SAVE OFF-HOST — lose it, lose the repo
OSS_BUCKET=
OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
OSS_REGION=oss-cn-shenzhen
OSS_ACCESS_KEY_ID=
OSS_SECRET_ACCESS_KEY=
OSS_ROOT=mica
# optional: BACKUP_HOUR=3  KEEP_DAILY=7  KEEP_WEEKLY=4  KEEP_MONTHLY=6
#
# ── Backup leg 2 of 3: the DATABASE (label=_pgdump) ──────────────────────────
# WITHOUT THIS THE BACKUP IS CONTENT-ONLY. The workspace export above is
# portable Markdown+images; it does NOT carry accounts, memberships, CRDT edit
# history, version checkpoints, comments or share tokens — those live only in
# Postgres. Unset → mica-backup.sh skips pg_dump, logs a WARN, and still exits
# 0, so the dead man's switch stays GREEN while you have no DB disaster
# recovery at all. That is exactly what happened on this deployment until
# 2026-07-30 (docs/dr-plan.md §1.1). The backup container shares the default
# network with postgres, so the host is literally `postgres`:
MICA_BACKUP_PGURL=postgres://mica:<POSTGRES_PASSWORD>@postgres:5432/mica
#
# ── Backup leg 3 of 3: the OBJECT BYTES (rclone, S3→S3, not through rustic) ──
# Images reach the off-site store today only as a side effect of the content
# export, so coverage is decided by the export's rules (is_deleted=false) —
# not by what is actually in the bucket. This leg mirrors the bucket itself.
# Any of these unset → the leg is skipped with a WARN.
# Source = the RustFS configured above; reuse its credentials.
RUSTFS_S3_ACCESS_KEY_ID=
RUSTFS_S3_SECRET_ACCESS_KEY=
# optional: RUSTFS_S3_ENDPOINT=http://rustfs:9000   RUSTFS_S3_BUCKET=mica
# Destination = usually the same OSS bucket as the rustic repo, under its own
# prefix so plain objects never mix with repo internals.
OSS_BLOB_BUCKET=
# optional: OSS_BLOB_ROOT=mica-blobs
