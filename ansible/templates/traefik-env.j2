{{ ansible_managed | comment }}
# Rendered by ansible/provision.yml. EDITS HERE ARE REVERTED by the next run.
#
# TRAEFIK_BASIC_AUTH guards the dashboard route and is a CREDENTIAL: it is read
# from the environment of whoever runs the play, never from host_vars, and is
# never written back to the repo. Generate one with:
#
#     htpasswd -nbB admin '<password>'
#
# The `$` doubling below is load-bearing, not defensive. Compose interpolates
# this file, so every `$` in an htpasswd hash (`$apr1$…`, `$2y$…`) is read as a
# variable reference and silently replaced with an empty string — measured
# 2026-08-29: `The "apr1" variable is not set. Defaulting to a blank string.`
# Traefik then comes up with a MANGLED credential rather than a broken one,
# which is the failure you find out about by not being able to log in.
{% for key, value in traefik_env.items() %}
{{ key }}={{ value }}
{% endfor %}
TRAEFIK_BASIC_AUTH={{ lookup('env', 'TRAEFIK_BASIC_AUTH') | replace('$', '$$') }}
