#!/bin/sh
{{ ansible_managed | comment }}
#
# Credentials live in .env.secrets, and `docker compose` only auto-reads .env —
# so a bare `docker compose ps` on this node reports JWT_SECRET and friends as
# missing. Use this wrapper instead:
#
#     cd {{ mica_dir }} && ./dc ps
#     ./dc logs -f api
#     ./dc up -d --no-deps api
#
# That split is deliberate: .env is RENDERED from the repo on every deploy, and
# that is only safe because the credentials sit in a file ansible never touches.
# The cost is this wrapper. It is a fair trade but a real cost — the failure
# mode is a confusing "variable is not set" on an otherwise correct command,
# which is why this is a comment here rather than a line in a document.
#
# Emergency version change (only if GitHub is down): edit MICA_VERSION in .env,
# then `./dc up -d --no-deps api web`. That edit, like any other edit to .env,
# is REVERTED by the next deploy — the normal path is the Deploy workflow or
# `just deploy-prod X.Y.Z` from a checkout. Do not settle here.
exec docker compose \
  --env-file {{ mica_dir }}/.env \
  --env-file {{ mica_dir }}/.env.secrets \
  "$@"
