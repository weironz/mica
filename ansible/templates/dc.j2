#!/bin/sh
{{ ansible_managed | comment }}
#
# ALWAYS USE THIS INSTEAD OF BARE `docker compose` IN THIS DIRECTORY.
#
#     cd {{ mica_dir }} && ./dc ps
#     ./dc logs -f api
#     ./dc up -d --no-deps api
#
# Credentials live in .env.secrets, and `docker compose` only auto-reads .env.
# It does NOT complain about that — measured, not assumed. Mica's compose spells
# the credentials `${VAR}` and not `${VAR:?}`, so a missing one resolves to an
# EMPTY STRING and the command succeeds:
#
#     docker compose up -d api     # api comes back with an empty JWT_SECRET
#                                  # (the server mints a new one -> every
#                                  # session is logged out) and an empty
#                                  # database password (-> it cannot connect)
#
# Making them `${VAR:?}` would fix that, and is deliberately not done: those
# defaults exist so a self-hoster can start the stack with no credentials at
# all, which was decided on purpose (docs/deploy.md). Reversing it here would
# move the cost onto everyone else to protect one operator on one node.
#
# So the guard is this wrapper plus this comment. That is a real, remaining
# sharp edge, and it is the price of .env being rendered from the repo every
# deploy — which is only safe because the credentials are in a file ansible
# never touches.
#
# Emergency version change (only if GitHub is down): edit MICA_VERSION in .env,
# then `./dc up -d --no-deps api web`. That edit, like any other edit to .env,
# is REVERTED by the next deploy — the normal path is the Deploy workflow or
# `just deploy-prod X.Y.Z` from a checkout. Do not settle here.
exec docker compose \
  --env-file {{ mica_dir }}/.env \
  --env-file {{ mica_dir }}/.env.secrets \
  "$@"
