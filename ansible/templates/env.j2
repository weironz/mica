{{ ansible_managed | comment }}
# Rendered by ansible/deploy.yml from ansible/host_vars/mica-prod.yml on every
# deploy. EDITS HERE ARE REVERTED by the next deploy — change host_vars instead.
#
# Credentials are NOT in this file. They live in .env.secrets beside it, which
# ansible never reads or writes. Both are handed to compose together:
#
#     docker compose --env-file .env --env-file .env.secrets ...
#
# which is what ./dc does. Bare `docker compose` reads only this file and does
# NOT complain — the credentials resolve to empty strings and the command
# succeeds. Use ./dc; the full explanation is in its header.
MICA_VERSION={{ mica_version }}
{% for key, value in mica_env.items() %}
{{ key }}={{ value }}
{% endfor %}
