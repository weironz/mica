# Environment for the `container` job in ci.yml — LOCAL THROWAWAY VALUES ONLY.
#
# Committed on purpose: there is nothing secret here, and requiring a secret file
# is exactly why that check went unrun for so long. It used to read `.env.prod`,
# that holds REAL production credentials (JWT signing key, database password, S3
# the file holding REAL production credentials (JWT signing key, database
# password, S3 keys, even the Aliyun backup AccessKey) — so a container check
# demanded a full production credential set before it would start. Nobody set
# that up, so nobody ever ran the check.
#
# These values only ever reach containers on this machine, against volumes
# (mica-prod-postgres / mica-prod-rustfs) that hold nothing but check data.
# NEVER point a real deployment at this file.

# The single-server variant signs presigned S3 URLs against this host, and
# RustFS allows CORS from it. Localhost is what a local check talks to.
SERVER_IP=127.0.0.1

# single.yml requires MICA_VERSION — a quickstart must not silently install some
# tag that was current when the file was written. This check does not pull (the
# from-source overlay builds the api from the working tree), so it is only the
# tag that build gets. Deliberately not a real release number: seeing
# `ci-local` in `docker images` should be unmistakable.
MICA_VERSION=ci-local

# `:?`-required by deploy/docker-compose.single.yml. Fixed junk, not generated:
# a stable value keeps the postgres volume reusable across runs.
#
# At least 32 characters, because `validate_jwt_secret` refuses a shorter one in
# production mode and this stack boots in production mode. The old 15-character
# value made the api exit at startup with `failed to load configuration`, which
# is why the Container job was red for over a day — the one job whose entire
# purpose is "does the production image actually boot". Junk, but long junk.
JWT_SECRET=ci-not-a-secret-ci-not-a-secret-ci-not-a-secret
POSTGRES_USER=mica
POSTGRES_PASSWORD=ci-not-a-secret
POSTGRES_DB=mica

S3_BUCKET=mica
S3_ACCESS_KEY=ci-not-a-secret
S3_SECRET_KEY=ci-not-a-secret
S3_REGION=us-east-1
